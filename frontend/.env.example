# Copy this file to .env.local and fill in the address printed by your deploy script
# (e.g. from `npx hardhat run scripts/deploy.ts --network localhost`)
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Your local Hardhat node's JSON-RPC endpoint (default shown)
VITE_RPC_URL=http://127.0.0.1:8545

# Hardhat's default local network chain id
VITE_CHAIN_ID=31337
