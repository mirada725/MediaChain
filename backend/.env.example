# Local Hardhat network RPC endpoint (from `npx hardhat node`)
RPC_URL=http://127.0.0.1:8545

# Contract address printed by `npx hardhat run scripts/deploy.ts --network localhost`
CONTRACT_ADDRESS=

# Private key of one of Hardhat's pre-funded test accounts
# (printed by `npx hardhat node` when it starts — safe to use locally,
# NEVER use a real-money private key here or in any committed file)
PRIVATE_KEY=

# Port the Express server listens on
PORT=3000